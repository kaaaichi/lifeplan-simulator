{
  "name": "lifeplan-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fb": "vite --mode firebase",
    "build": "vite build",
    "build:fb": "vite build --mode firebase",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.integration.test.tsx'",
    "test:integration": "vitest run integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:emu": "firebase emulators:exec --only firestore --project demo-lifeplan \"vitest run emu.test\"",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:hosting": "npm run build:fb && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.22.4",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.1",
    "zustand": "^5.0.14"
  }
}
