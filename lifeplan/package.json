{
  "name": "lifeplan-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fb": "vite --mode firebase",
    "build": "vite build",
    "build:fb": "vite build --mode firebase",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.integration.test.tsx'",
    "test:integration": "vitest run integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:emu": "firebase emulators:exec --only firestore --project demo-lifeplan \"vitest run emu.test\"",
    "deploy:rules": "firebase deploy --only firestore",
    "deploy:hosting": "npm run build:fb && firebase deploy --only hosting"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@fastify/busboy": "3.2.2",
    "@grpc/grpc-js": "1.14.6",
    "@hono/node-server": "1.19.17",
    "@modelcontextprotocol/sdk": "1.32.1",
    "body-parser@^1": "1.20.8",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^2": "2.1.7",
    "brace-expansion@^5": "5.0.12",
    "compression": "1.8.2",
    "express@^4": "4.22.3",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "js-yaml": "4.3.2",
    "morgan": "1.12.1",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "re2": "1.27.0",
    "undici@^6": "6.29.0",
    "undici@^8": "8.11.2"
  }
}
